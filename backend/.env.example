# ============================================================================
# Boongood AI Company - Backend Environment Variables (.env.example)
# Copy thành .env khi chạy cục bộ, hoặc khai báo trong Cloud Run Env Variables.
# KHÔNG commit file .env chứa khóa thật lên GitHub!
# ============================================================================

# --- 1. Gemini API (Google AI Studio) ---
GEMINI_API_KEY=your_gemini_api_key_here
# Model cho chế độ Chatbot PASSIVE (tương thích Free Tier, tiết kiệm nhất)
GEMINI_MODEL_PASSIVE=gemini-3.5-flash-lite
# Model cho chế độ Agent AUTONOMOUS (tối đa 3 vòng suy luận, hỗ trợ function calling)
GEMINI_MODEL_AUTONOMOUS=gemini-3.8-flash

# --- 2. Supabase (Project Settings -> API) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- 3. Workspace Bridge (Lớp 1 - Google Apps Script Web App /exec) ---
BRIDGE_URL=https://script.google.com/macros/s/your_deployment_id/exec
BRIDGE_SECRET=your_api_secret_from_script_properties

# --- 4. Bảo mật & Tùy chỉnh (Khuyến nghị đặt khi deploy Cloud Run) ---
# Nếu đặt giá trị, mọi request tới /api/* cần gửi header: X-API-Key: <BACKEND_API_KEY>
# Để trống khi chỉ chạy test cục bộ trên máy cá nhân.
BACKEND_API_KEY=
# Danh sách domain Frontend được phép gọi CORS (phân tách bằng dấu phẩy, mặc định *)
ALLOWED_ORIGINS=*
# Giới hạn lịch sử chat gửi kèm mỗi lượt PASSIVE (mặc định 8)
MAX_CHAT_HISTORY=8
# Giới hạn cứng số vòng suy luận chế độ AUTONOMOUS (mặc định 3)
MAX_AUTONOMOUS_STEPS=3

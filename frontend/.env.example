# ============================================================================
# Boongood × Friends Living 3D Office — Frontend Environment Variables
# Copy thành .env khi chạy cục bộ hoặc khai báo trên Vercel / Netlify.
# Nếu để trống, ứng dụng vẫn chạy mượt toàn bộ 3D Office 0-token ở Demo Mode.
# ============================================================================

# URL Backend Layer 2 (Cloud Run hoặc http://127.0.0.1:8080 khi chạy máy cá nhân)
VITE_API_BASE_URL=

# Khóa X-API-Key trùng với BACKEND_API_KEY của Backend (để trống nếu Backend không bật khóa)
VITE_BACKEND_API_KEY=

# Supabase Realtime (tùy chọn — dùng Project URL & anon public key để đồng bộ trạng thái 3D tức thì)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
